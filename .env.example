SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite (dev default)
# DATABASE_URL=sqlite:///db.sqlite3

# Postgres (prod)
# DATABASE_URL=postgres://user:pass@db:5432/schedule_irp

# Scheduler service bearer token (for /api/v1/ endpoints)
SCHEDULER_API_TOKEN=replace-me

# Email (dev default is console backend — links print to stdout)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@schedule-irp.local

# Used to build absolute URLs in outgoing emails (magic links)
SITE_URL=http://127.0.0.1:8000
